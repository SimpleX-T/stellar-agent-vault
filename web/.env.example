# Stellar network
VITE_NETWORK=TESTNET
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed SpendVault contract
VITE_CONTRACT_ID=CDDIK44X6QKACSGXJ37LKNLTOA3FAFYWMNICUP6MGVWRWHU7ZC4FMQ5L
# Native XLM Stellar Asset Contract (the vault's token)
VITE_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Funded account used only as the source for read-only view simulation
VITE_READ_SOURCE=GA5BJ4WO2MU7ZD56RDWKIDHNARKOWSLDFXZRUZQE5UUDIKEMQ6EQKJRZ

# VaultFactory (registry-enabled — all_vaults() backs the admin dashboard)
VITE_FACTORY_ID=CCZQRQXVI7OKH4JISBQASCFG65XIPT5RF4X7V52OHXO4Z54AY2UNBKTV

# ── Observability (optional) ─────────────────────────────────────────────
# Both are optional: leave blank and the app runs with analytics/monitoring
# disabled (no-op). Fill them in to light up dashboards.

# PostHog — product analytics + in-app feedback surveys.
# Project API key from https://posthog.com (Project Settings). "phc_..."
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — error tracking. DSN from https://sentry.io (free Developer tier).
VITE_SENTRY_DSN=

# ── Admin dashboard (/#/admin) ───────────────────────────────────────────
# Wallets allowed into the operator dashboard, in addition to the on-chain
# factory admin. Comma-separated G... addresses (put your Freighter address here).
VITE_ADMIN_ADDRESS=
# Optional deep links shown on the dashboard (your project URLs).
VITE_POSTHOG_PROJECT_URL=
VITE_SENTRY_PROJECT_URL=
